{
  "expo": {
    "name": "Owlvix",
    "slug": "owlvix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "owlvix",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070b14",
    "ios": {
      "bundleIdentifier": "com.owlvix.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.owlvix.app",
      "adaptiveIcon": {
        "backgroundColor": "#1ec773",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f7fb",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#070b14",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1ec773"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Owlvix uses your photos so you can add project screenshots to your portfolio.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f7093255-1732-409d-a2a7-fb5405fa56ad"
      }
    },
    "owner": "jawad.itic"
  }
}
