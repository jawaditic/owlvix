APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Google reCAPTCHA v3 — get keys at https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Google Analytics 4 measurement ID (G-...), from analytics.google.com → Admin → Data streams
GA_MEASUREMENT_ID=

# Microsoft Clarity project ID (clarity.microsoft.com → Settings → Overview)
CLARITY_PROJECT_ID=

# Contentsquare tag ID (app.contentsquare.com → Install Contentsquare → Tag)
CONTENTSQUARE_TAG_ID=

# IndexNow key (tells Bing when pages change). Any 32 letters/digits, e.g. from: php -r "echo bin2hex(random_bytes(16));"
INDEXNOW_KEY=

# Free website speed test (/website-speed-test): Google PageSpeed Insights API key
PAGESPEED_API_KEY=

# Mobile app builder (/mobile-app-builder): Android builds run on GitHub Actions.
# Token: a fine-grained GitHub token for this repository only, with "Actions: read and write".
APP_BUILDER_REPO=
APP_BUILDER_GITHUB_TOKEN=
# Same value as the GitHub repo secret OWLVIX_RUNNER_KEY (openssl rand -hex 32)
APP_BUILDER_RUNNER_KEY=
APP_BUILDER_MONTHLY_LIMIT=100
# App content and finished app files are static files in public/app-data (served by the web server, not PHP).
# Change only if the public folder is elsewhere, e.g. /home/user/public_html/app-data and https://owlvix.com/app-data
APP_BUILDER_PUBLIC_DIR=
APP_BUILDER_PUBLIC_URL=

# Online payments in apps (Stripe Connect): owlvix's platform keys, test and live (see config/builder.php)
APP_BUILDER_PAYMENTS=true
STRIPE_TEST_SECRET=
STRIPE_TEST_CLIENT_ID=
STRIPE_LIVE_SECRET=
STRIPE_LIVE_CLIENT_ID=
APP_BUILDER_STRIPE_FEE=0
